{
  "auto_optimization": true,
  "voice_listener_enabled": true,
  "camera_sensor_enabled": true,
  "emotion_engine_tuning": true,
  "reflection_journal_enabled": true,
  "rituals_enabled": true,
  "modules_to_load": [
    "unimind",
    "codex",
    "emotion",
    "voice",
    "optimizer",
    "sensors",
    "scrolls",
    "devices",
    "prometheus",
    "memory_tree",
    "introspection"
  ],
  "devices": {
    "codex_ingest_enabled": true,
    "drivers": {
      "ssdp": {
        "enabled": true,
        "interval_s": 30,
        "mx": 2,
        "st": "ssdp:all",
        "timeout_s": 3
      },
      "arp": {
        "enabled": true,
        "interval_s": 60,
        "arp_path": "/proc/net/arp"
      }
