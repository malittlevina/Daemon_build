{
  "meta": {
    "description": "Configuration for creative generation APIs",
    "version": "1.0"
  },
  
  "image_generation": {
    "enabled": false,
    "provider": "stable_diffusion",
    "providers": {
      "stable_diffusion": {
        "api_url": "http://localhost:7860/sdapi/v1/txt2img",
        "model": "sd_xl_base_1.0",
        "default_params": {
          "steps": 30,
          "cfg_scale": 7.5,
          "width": 1024,
          "height": 1024,
          "sampler_name": "DPM++ 2M Karras"
        }
      },
      "dalle": {
        "api_url": "https://api.openai.com/v1/images/generations",
        "api_key_env": "OPENAI_API_KEY",
        "model": "dall-e-3",
        "default_params": {
          "size": "1024x1024",
          "quality": "standard"
        }
      },
      "midjourney": {
        "api_url": "https://api.midjourney.com/v1/imagine",
        "api_key_env": "MIDJOURNEY_API_KEY"
      },
      "replicate": {
        "api_url": "https://api.replicate.com/v1/predictions",
        "api_key_env": "REPLICATE_API_TOKEN",
        "model": "stability-ai/sdxl"
      }
    }
  },
  
  "video_generation": {
    "enabled": false,
    "provider": "runway",
    "providers": {
      "runway": {
        "api_url": "https://api.runwayml.com/v1/generations",
        "api_key_env": "RUNWAY_API_KEY",
        "model": "gen-3"
      },
      "pika": {
        "api_url": "https://api.pika.art/v1/generate",
        "api_key_env": "PIKA_API_KEY"
      },
      "replicate_video": {
        "api_url": "https://api.replicate.com/v1/predictions",
        "api_key_env": "REPLICATE_API_TOKEN",
        "model": "stability-ai/stable-video-diffusion"
      }
    }
  },
  
  "audio_generation": {
    "enabled": false,
    "provider": "elevenlabs",
    "providers": {
      "elevenlabs": {
        "api_url": "https://api.elevenlabs.io/v1/text-to-speech",
        "api_key_env": "ELEVENLABS_API_KEY",
        "voice_id": "21m00Tcm4TlvDq8ikWAM",
        "model": "eleven_multilingual_v2"
      },
      "bark": {
        "local": true,
        "model_path": "models/bark",
        "voice_preset": "v2/en_speaker_6"
      },
      "openai_tts": {
        "api_url": "https://api.openai.com/v1/audio/speech",
        "api_key_env": "OPENAI_API_KEY",
        "model": "tts-1-hd",
        "voice": "alloy"
      }
    }
  },
  
  "model_3d_generation": {
    "enabled": false,
    "provider": "point_e",
    "providers": {
      "point_e": {
        "local": true,
        "model_path": "models/point_e"
      },
      "shap_e": {
        "local": true,
        "model_path": "models/shap_e"
      },
      "replicate_3d": {
        "api_url": "https://api.replicate.com/v1/predictions",
        "api_key_env": "REPLICATE_API_TOKEN",
        "model": "cjwbw/shap-e"
      },
      "meshy": {
        "api_url": "https://api.meshy.ai/v2/text-to-3d",
        "api_key_env": "MESHY_API_KEY"
      }
    }
  },
  
  "code_generation": {
    "enabled": true,
    "provider": "ollama",
    "providers": {
      "ollama": {
        "api_url": "http://localhost:11434/api/generate",
        "models": {
          "python": "codellama:13b-python",
          "general": "codellama:13b-instruct",
          "rust": "codellama:13b",
          "typescript": "codellama:13b"
        }
      },
      "openai": {
        "api_url": "https://api.openai.com/v1/chat/completions",
        "api_key_env": "OPENAI_API_KEY",
        "model": "gpt-4-turbo"
      },
      "anthropic": {
        "api_url": "https://api.anthropic.com/v1/messages",
        "api_key_env": "ANTHROPIC_API_KEY",
        "model": "claude-3-opus-20240229"
      }
    }
  },
  
  "output_paths": {
    "images": "generated/images",
    "videos": "generated/videos",
    "audio": "generated/audio",
    "models_3d": "generated/3d",
    "code": "generated/code"
  }
}
